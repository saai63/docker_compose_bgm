{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 19 * * *"
  ],
  "docker-compose": {
    "fileMatch": [
      "(^|/)docker-compose[^/]*\\.ya?ml$"
    ]
  },
  "packageRules": [
    {
      "matchPackagePatterns": [
        "^ghcr\\.io/immich-app/"
      ],
      "groupName": "Immich Core Suite"
    }
  ]
}
