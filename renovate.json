{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:recommended"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "dependencyDashboard": true,
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)docker-compose[^/]*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "groupName": "Immich Core Suite",
      "matchPackageNames": [
        "ghcr.io/immich-app/**"
      ]
    },
    {
      "groupName": "ARR suite",
      "matchPackageNames": [
	    "linuxserver/prowlarr",
	    "linuxserver/sonarr",
	    "linuxserver/lidarr",
	    "linuxserver/radarr",
	    "lscr.io/linuxserver/bazarr"
      ],
	  "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\.(?<build>\\d+))?-ls(?<revision>\\d+)$"
    },
	{
      "matchPackageNames": ["linuxserver/qbittorrent"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)_v[\\d.]+-ls(?<revision>\\d+)$"
    }
  ]
}
