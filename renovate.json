{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:recommended"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "dependencyDashboard": true,
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 21 * * *"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)docker-compose[^/]*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "groupName": "Immich Core Suite",
      "matchPackageNames": [
        "/^ghcr\\.io/immich-app//"
      ]
    },
    {
      "groupName": "ARR suite",
      "matchPackageNames": [
        "/^qmcgaw/gluetun//",
	"/^linuxserver/prowlarr//",
	"/^linuxserver/sonarr//",
	"/^linuxserver/lidarr//",
	"/^linuxserver/radarr//",
	"/^linuxserver/qbittorrent//",
	"/^lscr\\.io/linuxserver/bazarr//"
      ]
    }
  ]
}
