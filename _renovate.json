{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:recommended"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "dependencyDashboard": true,
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 20 * * *"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)docker-compose[^/]*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "groupName": "Immich Core Suite",
      "matchPackageNames": [
        "/^ghcr\\.io/immich-app//"
      ]
    }
  ]
}
